[include]
    path=userConfig

[core]
    editor = nvim
[diff]
    tool = nvimdiff
[difftool "nvimdiff"]
    cmd = nvim -d "$LOCAL" "$REMOTE"

[merge]
    tool = nvimdiff
[mergetool "nvimdiff"]
    cmd = nvim -d -c "4wincmd w | wincmd J" "$LOCAL" "$BASE" "$REMOTE" 

[help]
    autoCorrect = prompt

[branch]
    sort = -committerdate
[tag]
    sort = version:refname

[commit]
    verbose = true
[push]
    autoSetupRemote = true
[init]
    defaultBranch = main
[pull]
	ff = only
